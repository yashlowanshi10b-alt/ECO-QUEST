# ==========================================
# EcoQuest Server Environment Configuration
# ==========================================
# PORT: Local backend listening port
PORT=5000

# AI_PROVIDER: "groq" | "huggingface" | "ollama" | "mock"
# Default is "mock" for zero-config offline playability
AI_PROVIDER=mock

# ==========================================
# Open-Weight Model API Keys (Server-Side Only)
# NEVER commit your actual .env file or expose these in frontend code!
# ==========================================

# Groq (Hosted Open-Weight Llama 3.1 8B Instant)
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Hugging Face (Hosted Open-Weight Inference)
# Get a free access token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Ollama Local Endpoint (if running open weights locally)
# Default is http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
